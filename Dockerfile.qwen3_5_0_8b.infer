FROM python:3.11-slim-trixie

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/workspace/models/.cache/huggingface \
    TRANSFORMERS_CACHE=/workspace/models/.cache/huggingface \
    ORTGENAI_CACHE=/workspace/models/.cache/onnxruntime-genai

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip setuptools wheel packaging

# Inference stack for tools/inference/*.py (ONNX GenAI + chat template).
# No PyTorch or ONNX export deps — use Dockerfile.qwen3_5_0_8b.export to build bundles.
RUN python -m pip install --pre \
    "transformers>=5.3" \
    "onnxruntime>=1.18" \
    "onnxruntime-genai" \
    "huggingface-hub" \
    "tokenizers" \
    "safetensors" \
    "fastapi" \
    "pydantic" \
    "uvicorn[standard]"

EXPOSE 8080

# Mount the repo at /workspace, then for example:
#   python3 tools/inference/chat_qwen3_5_onnx.py --prompt "你好"
#   python3 tools/inference/serve_qwen3_5_onnx_openai.py --host 0.0.0.0 --port 8080
CMD ["bash"]
